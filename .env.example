# Copy this file to .env and fill in your own values to enable the optional
# Notion sync (mirrors scrape_history.json into the "Scraper Health Tracker"
# database after every run). Leave .env absent/unset to skip Notion entirely
# — the scraper works fine without it.
#
# 1. Create a token at https://www.notion.so/my-integrations ("New integration")
# 2. Open the "Scraper Health Tracker" database in Notion, click "..." → "Connections",
#    and add the integration you just created
# 3. Paste the secret token below

NOTION_TOKEN=
NOTION_DATABASE_ID=fdfa1f7c043b464ab31f104c7fb55b24
